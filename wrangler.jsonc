/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "VALCORNER_SCOPE": "openid email profile",
    "VALCORNER_AUTHORIZE_URL": "https://auth.valcorner.qzz.io/oauth/authorize",
    "VALCORNER_TOKEN_URL": "https://auth.valcorner.qzz.io/oauth2/token",
    "VALCORNER_USERINFO_URL": "https://auth.valcorner.qzz.io/oauth/userinfo",
    "FRONTEND_URL": "https://video.valcorner.qzz.io",
    "VALCORNER_REDIRECT_URI": "https://video.valcorner.qzz.io/login.html"
  },
  "secrets": [
    { "name": "VALCORNER_CLIENT_ID",    "value": "REPLACE_WITH_REAL_VALUE" },
    { "name": "VALCORNER_CLIENT_SECRET", "value": "REPLACE_WITH_REAL_VALUE" },
    { "name": "ADS_API_KEY",            "value": "REPLACE_WITH_REAL_VALUE" }
  ]
}
